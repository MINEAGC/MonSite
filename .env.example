HOST=127.0.0.1
PORT=3000
NODE_ENV=development
TIME_ZONE=Europe/Paris
DATA_RETENTION_DAYS=90

# Le serveur crée un mot de passe admin aléatoire au premier démarrage.
# Il sera affiché une seule fois dans le terminal puis enregistré sous forme hachée dans .env.
ADMIN_USER=admin

# Pour activer les notifications et accusés de réception par e-mail,
# renseigner les paramètres SMTP et remplacer les e-mails .example dans config.js.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# À définir lors d'un déploiement derrière HTTPS, par exemple https://www.monsite.fr
PUBLIC_ORIGIN=
